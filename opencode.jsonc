{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["~/.agents/skills/odoo-19", ".agents/skills"]
  },
  "agent": {
    "spec-verify": {
      "description": "Verifica, corrige y marca los checks de 'Criterios de aceptación' de un spec en specs/. Usa Context7 si el spec depende de librerías externas.",
      "mode": "primary",
      "prompt": "{file:./.agents/spec-verify.prompt.md}",
      "permission": {
        "edit": {
          "specs/**": "allow",
          "*": "deny"
        },
        "bash": "ask"
      }
    }
  },
  "command": {
    "spec-verify": {
      "description": "Verifica los criterios de aceptación de un spec.",
      "agent": "spec-verify",
      "template": "Verifica los criterios de aceptación del spec: $ARGUMENTS"
    },
    "spec": {
      "description": "Crea especificaciones de pantallas y funcionalidades",
      "template": "Carga y sigue la skill spec en .agents/skills/spec/SKILL.md.\n\nFeature: $ARGUMENTS"
    },
    "spec-impl": {
      "description": "Implementa especificaciones de pantallas y funcionalidades",
      "template": "Carga y sigue la skill spec-impl en .agents/skills/spec-impl/SKILL.md.\n\nFeature: $ARGUMENTS"
    }
  },
  "instructions": ["instructions.md"],
  "mcp": {
    "odoo-server": {
      "type": "local",
      "command": ["odoo-mcp"],
      "environment": {
        "ODOO_URL": "http://127.0.0.1:38069",
        "ODOO_DB": "dbodoo20",
        "ODOO_USERNAME": "admin",
        "ODOO_PASSWORD": "25b3b69ea4b6b8f98d8eebb40456a76dfe9a5da8",
        "ODOO_API_KEY": "25b3b69ea4b6b8f98d8eebb40456a76dfe9a5da8",
        "ODOO_TRANSPORT": "json2",
        "ODOO_JSON2_DATABASE_HEADER": "1",
        "ODOO_MCP_ENABLE_WRITES": "1"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp", "--headless", "--browser", "chromium"],
      "environment": {
        "LD_LIBRARY_PATH": "/home/odoo/.local/lib/alsa"
      },
      "timeout": 20000,
      "enabled": false
    }
  }
}
